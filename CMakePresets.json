{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Release (Qt6 found on CMAKE_PREFIX_PATH)",
      "description": "Set CMAKE_PREFIX_PATH or Qt6_DIR in the environment, or use a preset below."
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-mingw",
      "inherits": "base",
      "displayName": "Windows / Qt MinGW kit",
      "description": "Adjust the paths if your Qt lives elsewhere.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/mingw_64",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base",
      "displayName": "Windows / Qt MSVC kit",
      "description": "Run from a Developer Command Prompt.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" }
  ]
}
